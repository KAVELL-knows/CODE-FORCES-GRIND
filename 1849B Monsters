# 1849B. Monsters
n = int(input())
for t in range(n):
    x, y = map(int, input().split())
    nums = list(map(int, input().split()))

    final = []
    for j in range(x):
        remainder = nums[j] % y

        if remainder == 0:
            remainder = y

        final.append((remainder, j + 1))
    final.sort(key=lambda x: (-x[0], x[1]))
    for remainder, index in final:
        print(index, end=" ")
    print()
