#2173A. Sleeping Through Classes
t = int(input())

for i in range(t):
    n, k = map(int, input().split())
    classes = input()
    
    sleep = 0
    awake_remaining = 0
    
    for j in classes:
        if j == '1':
            awake_remaining = k
        else:
            if awake_remaining > 0:
                awake_remaining -= 1
            else:
                sleep += 1
                
    print(sleep)
