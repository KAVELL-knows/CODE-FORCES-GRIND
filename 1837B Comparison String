#1837B. Comparison String
t = int(input())

for i in range(t):
    n = int(input())
    line = input()
    
    max_streak = 1
    count = 1
    
    for i in range(n - 1):
        if line[i] == line[i + 1]:
            count += 1
            if count > max_streak:
                max_streak = count
        else:
            count = 1
            
    print(max_streak + 1)
