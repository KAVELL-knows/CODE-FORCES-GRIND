#testing for an integer prime number

#By definition, a prime number is a whole number greater than 1 that has exactly two positive factors: 1 and itself.

x = input("Please enter a number to test whether it is prime!")
x = int(x)
if x < 2:
    print(x, "is not a prime number.")
else:
    for i in range(2, int(x**0.5)+1):
        if x % i == 0:
            print(x, "is not a prime number.")
            break
    else:
        print(x,"is a prime number.")


#We only check factors up to the square because factors occur in pairs.
#Any factor greater than √x has a corresponding factor less than √x, so checking beyond the square root is unnecessary.
