#381A. Sereja and Dima

n = int(input())
score = list(map(int, input().split()))

sereja = 0 
dima = 0 
iteration = 0 

while iteration < n:
    if iteration % 2 == 0:
        if score[0] > score[-1]:
            sereja += score.pop(0) 
        else:
            sereja += score.pop(-1) 
        iteration += 1

    else:

        if score[0] > score[-1]:
            dima += score.pop(0)
        else:
            dima += score.pop(-1)
        iteration += 1

print(sereja, dima)
