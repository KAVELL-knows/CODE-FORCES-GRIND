#486B

#m rows 
#n columns 
m, n = map(int, input().split())

B = [list(map(int, input().split())) for _ in range(m)] #Matrix B

A = [[1] * n for _ in range(m)] #Matrix A

for i in range(m):
    for j in range(n):
        if B[i][j] == 0:
            for k in range(n):
                A[i][k] = 0

            for k in range(m):
                A[k][j] = 0

for i in range(m):
    for j in range(n):
        value = 0

        for k in range(n):
            value |= A[i][k]
        for k in range(m):
            value |= A[k][j]
        if value != B[i][j]:
            print("NO")
            exit()
print("YES")

for row in A:
    print(*row)
