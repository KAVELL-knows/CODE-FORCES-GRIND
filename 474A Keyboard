#474A Keyboard

import sys
if __name__ == '__main__':
    x = []
    n = sys.stdin.readline().strip()
    text = sys.stdin.readline().strip()
    keyboard = "qwertyuiopasdfghjkl;zxcvbnm,./"
    if n == 'R':
        shift = -1 
    else:
        shift = 1
    for char in text:
        current_index = keyboard.index(char)
        x.append(keyboard[current_index + shift])    
    print("".join(x))
