#1360C. Similar Pairs
t = int(input())
for i in range(t):
    n = int(input())
    numbers = list(map(int, input().split()))
    numbers.sort()

    even = 0
    odd = 0

    for j in numbers:
        if j % 2 == 0:
            even += 1
        else:
            odd += 1

    if odd % 2 == 0:
        print("YES")
    else:
        possible = False
        for i in range(n - 1):
            if numbers[i + 1] - numbers[i] == 1:
                possible = True
                break
        
        if possible:
            print("YES")
        else:
            print("NO")
