n = int(input())
group = list(map(int, input().split()))

four = group.count(4)
three = group.count(3)
two = group.count(2)
one = group.count(1)

total = 0

total += four

total += three
one = max(0, one - three)

total += two // 2

if two % 2 == 1:
    total += 1
    one = max(0, one - 2)

if one > 0:
    total += (one + 3) // 4

print(total)
