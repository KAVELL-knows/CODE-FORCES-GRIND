class Solution:
    def findTheDistanceValue(self, arr1: list[int], arr2: list[int], d: int) -> int:
        max_len = 0 

        for i in arr1:
            count = True  
            
            for j in arr2:
                difference = abs(i - j)
                
                if difference <= d:
                    count = False  
                    break          
                    
            if count == True:
                max_len += 1       

        return max_len
