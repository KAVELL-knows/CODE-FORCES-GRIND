#160B Unlucky Ticket

n = int(input())
x = input()

first_half = list(map(int, x[:n]))
second_half = list(map(int, x[n:]))

first_half.sort() #ascending order
second_half.sort()

if all(first_half[i] < second_half[i] for i in range(n)):
    print("YES")
elif all(first_half[i] > second_half[i] for i in range(n)):
    print("YES")
else:
    print("NO")

