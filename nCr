# Manual code for the nCr
def manual_factorial(n):
    result = 1
    for i in range(1, n+1):
        result = result * i 
    return(result)

#nCr 

def n_choose_r(n, r):
    if n < 0:
        print("Undefined")
    elif n < r or r < 0:
        return 0
    numerator = manual_factorial(n)
    denominator = manual_factorial(n - r) * manual_factorial(r)

    nCr = numerator//denominator
    return nCr
