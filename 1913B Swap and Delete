#1913B. Swap and Delete
n = int(input())
for i in range(n):
    x = input()
    ones = x.count('1')
    zeros = x.count('0')
    if ones == zeros:
        print("0")
    elif len(x) == 1:
        print("1")
    else:
        matches = 0
        for i in x:
            if i == "1":
                if zeros == 0: 
                    break
                else: 
                    zeros -= 1
            elif i == "0":
                if ones == 0:  
                    break 
                else:
                    ones -= 1
            matches += 1 
        print(len(x) - matches)
