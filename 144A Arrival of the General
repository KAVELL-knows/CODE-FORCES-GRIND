#144A. Arrival of the General
n = int(input())
s = list(map(int, input().split()))
min = s[0]
max = s[0]
length1 = 0
length2 = 0
for i in range(n):
    if s[i] > max:
        max = s[i]
        length1 = i
for j in range(n):
    if s[j] < min:
        min = s[j]
        length2  = j
    elif s[j] == min:
        min = s[j]
        length2  = j
maxlen = length1
minlen = n - length2 - 1
total = minlen + maxlen
if total >= n:
    print(total -1)
else:
    print(total)
