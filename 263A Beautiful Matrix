for i in range(5):
    row = list(map(int,input().split())) #no of columns, row.index(1) searches for the number 1 and saves the column number
    if 1 in row:
        j = row.index(1)    #look for a row with 1, once that row is found 
        x = abs(j - 2)
        y = abs(i - 2) #asb gives the absolute number 
        p = x + y
        print(p) 

