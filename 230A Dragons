#230A. Dragons
s, n = map(int, input().split())
dragons = []
for i in range(n):
    x, y = map(int, input().split())
    dragons.append((x, y))
dragons.sort()
win = True
for x, y in dragons:
    if s <= x:
        win = False
        break  
    else:
        s += y  
if win:
    print("YES")
else:
    print("NO")
